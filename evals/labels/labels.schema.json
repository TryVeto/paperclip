{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunTraceOutcomeLabel",
  "type": "object",
  "required": ["runId", "companyId", "outcome", "labeledAt", "labeledBy"],
  "properties": {
    "runId": { "type": "string", "format": "uuid" },
    "companyId": { "type": "string", "format": "uuid" },
    "archiveId": { "type": "string", "format": "uuid" },
    "issueId": { "type": "string", "format": "uuid" },
    "outcome": {
      "type": "string",
      "enum": ["accepted", "rejected", "merged", "blocked", "needs_followup"]
    },
    "quality": {
      "type": "string",
      "enum": ["good", "mixed", "poor"]
    },
    "promoteToEval": { "type": "boolean" },
    "notes": { "type": "string" },
    "labeledAt": { "type": "string", "format": "date-time" },
    "labeledBy": { "type": "string" }
  },
  "additionalProperties": false
}
